{
  "wake_word": "хей луна",
  "wake_aliases": [
   "хей луна",
   "эй луна"
  ],
  "wake_engine": "vosk",
  "wake_model": "hey_loona.onnx",
  "wake_threshold": 0.5,
  "wake_confusables": [
   "луна", "луну", "лужа", "люда", "юля", "уна", "дума", "руна",
   "лупа", "нуна", "лун", "хей люда", "хей юля", "эй лужа",
   "лей луну", "хей ну на", "хей луна парк", "эй луна парк"
  ],
  "barge_in": {
    "enabled": true,
    "min_level": 0.002,
    "stop_words": [
      "стоп", "хватит", "тише", "замолчи", "перестань", "отмена",
      "остановись", "помолчи"
    ]
  },
  "language": "ru",
  "hotkey": "ctrl+alt+space",
  "notifications": true,
  "log_level": "INFO",

  "audio": {
    "sample_rate": 16000,
    "block_size": 4000,
    "input_device": null,
    "energy_threshold": 0.006,
    "noise_multiplier": 2.0,
    "pre_roll_sec": 1,
    "silence_ms": 800,
    "min_speech_ms": 250,
    "max_command_sec": 15,
    "no_speech_timeout_sec": 6,
    "vad_enabled": true,
    "vad_threshold": 0.5,
    "vad_model": "silero_vad.onnx",
    "duck_while_listening": true,
    "duck_level": 0.15,
    "duck_processes": ["chrome.exe"],
    "save_last_command": true
  },

  "stt": {
    "engine": "gigaam",
    "num_threads": 2,
    "tail_padding_sec": 0.4,
    "model": "small",
    "device": "cpu",
    "compute_type": "int8",
    "beam_size": 5,
    "initial_prompt": "Голосовые команды ассистенту: открой, включи, найди, поставь, пауза, следующее видео, закрой вкладку.",
    "parallel_english": false,
    "english_engine": "whisper",
    "english_model": "tiny",
    "english_num_threads": 4,
    "english_device": "cpu",
    "english_compute_type": "int8",
    "english_beam_size": 1,
    "english_crop_beam_size": 5,
    "english_locator": "vosk"
  },

  "browser": {
    "chrome_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "port": 9222,
    "profile_dir": "%LOCALAPPDATA%\\VoiceAssistant\\chrome-profile",
    "start_url": "https://www.google.com",
    "autoplay": true
  },

  "control": {
    "host": "127.0.0.1",
    "port": 8765
  },

  "context": {
    "ttl_sec": 180
  },

  "intent": {
    "enabled": true,
    "mode": "shadow",
    "base_url": "https://api.proxyapi.ru/v1",
    "api_key": "",
    "model": "openai/gpt-6-luna-decisions",
    "threshold": 0.6,
    "timeout_sec": 4.0,
    "answer_ttl_sec": 120
  },

  "opencode": {
    "enabled": true,
    "agent": "voice",
    "model": "opencode/deepseek-v4.1-flash-free",
    "triggers": ["спроси агента", "спроси у агента", "передай агенту", "агент"],
    "cli": "",
    "timeout_sec": 180,
    "standalone": false
  },

  "cloud_llm": {
    "enabled": true,
    "base_url": "https://api.proxyapi.ru/v1",
    "api_key": "",
    "model": "openai/gpt-6-luna",
    "fallback_models": ["xiaomi/mimo-v2.6-flash"],
    "reasoning_effort": "minimal",
    "model_params": {
      "openai/gpt-6-luna": {
        "temperature": null,
        "reasoning_effort": "none"
      }
    },
    "max_completion_tokens": 2000,
    "temperature": 0.2,
    "timeout_sec": 90,
    "retries": 2
  },

  "local_planner": {
    "enabled": false,
    "base_url": "http://127.0.0.1:11434/v1",
    "model": "qwen2.5:3b-instruct",
    "api_key": "",
    "timeout_sec": 20,
    "temperature": 0.0,
    "max_tokens": 256,
    "keep_alive": "30m"
  },

  "dialog": {
    "enabled": true,
    "entry_phrases": ["давай поговорим", "давай поболтаем", "поговорим", "поболтаем"],
    "exit_phrases": ["хватит", "закончим", "закончим разговор", "заверши разговор", "до свидания"],
    "idle_timeout_sec": 60,
    "max_utterance_sec": 60,
    "no_speech_timeout_sec": 10,
    "silence_ms": 1200,
    "max_tokens": 400,
    "temperature": 0.5,
    "timeout_sec": 60,
    "max_errors": 2,
    "history_messages": 12,
    "history_chars": 4000,
    "streaming": {
      "enabled": true
    },
    "context": {
      "budget_tokens": 6000,
      "chars_per_token": 2.5,
      "rolling_summary": {
        "enabled": true,
        "min_messages": 4,
        "max_chars": 1200,
        "max_input_chars": 4000,
        "max_tokens": 250,
        "timeout_sec": 30
      }
    },
    "profile_path": "state/profile.txt",
    "profile_chars": 4000,
    "persona_path": "state/luna.txt",
    "persona_chars": 2000,
    "persona_max_facts": 100,
    "db_path": "state/dialog.db",
    "character": {
      "enabled": true
    },
    "summary": {
      "enabled": true,
      "model": "",
      "max_input_chars": 6000,
      "max_tokens": 700,
      "temperature": 0.2,
      "timeout_sec": 45,
      "min_messages": 2,
      "background": true
    }
  },

  "memory": {
    "enabled": true,
    "model": "mongodb/voyage-4",
    "base_url": "",
    "api_key": "",
    "path": "state/chroma",
    "collection": "summaries",
    "top_k": 3,
    "min_score": 0.35,
    "min_margin": 0.05,
    "max_chars": 2400,
    "digest_min_messages": 6,
    "digest_limit": 3,
    "digest_item_chars": 320,
    "recent_limit": 2,
    "recent_item_chars": 320,
    "facts_limit": 6,
    "facts_max_chars": 900,
    "timeout_sec": 10,
    "index_version": 2
  }
}
