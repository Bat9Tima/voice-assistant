{
  "wake_word": "хей луна",
  "wake_aliases": [
   "хей луна",
   "эй луна"
  ],
  "wake_engine": "vosk",
  "wake_model": "hey_loona.onnx",
  "wake_threshold": 0.5,
  "wake_confusables": [
   "луна", "луну", "лужа", "люда", "юля", "уна", "дума", "руна",
   "лупа", "нуна", "лун", "хей люда", "хей юля", "эй лужа",
   "лей луну", "хей ну на", "хей луна парк", "эй луна парк"
  ],
  "language": "ru",
  "hotkey": "ctrl+alt+space",
  "notifications": true,
  "log_level": "INFO",

  "audio": {
    "sample_rate": 16000,
    "block_size": 4000,
    "input_device": null,
    "energy_threshold": 0.006,
    "noise_multiplier": 2.0,
    "pre_roll_sec": 1,
    "silence_ms": 800,
    "min_speech_ms": 250,
    "max_command_sec": 15,
    "no_speech_timeout_sec": 6,
    "vad_enabled": true,
    "vad_threshold": 0.5,
    "vad_model": "silero_vad.onnx",
    "duck_while_listening": true,
    "duck_level": 0.15,
    "duck_processes": ["chrome.exe"],
    "save_last_command": true
  },

  "stt": {
    "engine": "gigaam",
    "num_threads": 2,
    "tail_padding_sec": 0.4,
    "model": "small",
    "device": "cpu",
    "compute_type": "int8",
    "beam_size": 5,
    "initial_prompt": "Голосовые команды ассистенту: открой, включи, найди, поставь, пауза, следующее видео, закрой вкладку.",
    "parallel_english": false,
    "english_engine": "whisper",
    "english_model": "tiny",
    "english_num_threads": 4,
    "english_device": "cpu",
    "english_compute_type": "int8",
    "english_beam_size": 1,
    "english_crop_beam_size": 5,
    "english_locator": "vosk"
  },

  "browser": {
    "chrome_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "port": 9222,
    "profile_dir": "%LOCALAPPDATA%\\VoiceAssistant\\chrome-profile",
    "start_url": "https://www.google.com",
    "autoplay": true
  },

  "control": {
    "host": "127.0.0.1",
    "port": 8765
  },

  "context": {
    "ttl_sec": 180
  },

  "opencode": {
    "enabled": true,
    "agent": "voice",
    "model": "opencode/deepseek-v4.1-flash-free",
    "triggers": ["спроси агента", "спроси у агента", "передай агенту", "агент"],
    "cli": "",
    "timeout_sec": 180,
    "standalone": false
  },

  "cloud_llm": {
    "enabled": true,
    "base_url": "https://api.proxyapi.ru/v1",
    "api_key": "",
    "model": "anthropic/claude-haiku-5-5",
    "fallback_models": ["xiaomi/mimo-v2.6-flash"],
    "reasoning_effort": "minimal",
    "max_completion_tokens": 2000,
    "temperature": 0.2,
    "timeout_sec": 90,
    "retries": 2
  },

  "local_planner": {
    "enabled": false,
    "base_url": "http://127.0.0.1:11434/v1",
    "model": "qwen2.5:3b-instruct",
    "api_key": "",
    "timeout_sec": 20,
    "temperature": 0.0,
    "max_tokens": 256,
    "keep_alive": "30m"
  }
}
