{
  "wake_word": "хей луна",
  "wake_aliases": [
   "хей луна",
   "эй луна"
  ],
  "wake_engine": "vosk",
  "wake_model": "hey_loona.onnx",
  "wake_threshold": 0.5,
  "wake_confusables": [
   "луна", "луну", "лужа", "люда", "юля", "уна", "дума", "руна",
   "лупа", "нуна", "лун", "хей люда", "хей юля", "эй лужа",
   "лей луну", "хей ну на", "хей луна парк", "эй луна парк"
  ],
  "barge_in": {
    "enabled": true,
    "min_level": 0.002,
    "stop_words": [
      "стоп", "хватит", "тише", "замолчи", "перестань", "отмена",
      "остановись", "помолчи"
    ]
  },
  "language": "ru",
  "hotkey": "ctrl+alt+space",
  "pause_hotkey": "ctrl+alt+m",
  "notifications": true,
  "log_level": "INFO",

  "audio": {
    "sample_rate": 16000,
    "block_size": 4000,
    "input_device": null,
    "energy_threshold": 0.006,
    "noise_multiplier": 2.0,
    "pre_roll_sec": 1,
    "silence_ms": 800,
    "min_speech_ms": 250,
    "max_command_sec": 15,
    "no_speech_timeout_sec": 6,
    "vad_enabled": true,
    "vad_threshold": 0.5,
    "vad_model": "silero_vad.onnx",
    "duck_while_listening": true,
    "duck_level": 0.15,
    "duck_processes": ["chrome.exe"],
    "save_last_command": true
  },

  "stt": {
    "engine": "gigaam",
    "num_threads": 2,
    "tail_padding_sec": 0.4,
    "model": "small",
    "device": "cpu",
    "compute_type": "int8",
    "beam_size": 5,
    "initial_prompt": "Голосовые команды ассистенту: открой, включи, найди, поставь, пауза, следующее видео, закрой вкладку.",
    "parallel_english": false,
    "english_engine": "whisper",
    "english_model": "tiny",
    "english_num_threads": 4,
    "english_device": "cpu",
    "english_compute_type": "int8",
    "english_beam_size": 1,
    "english_crop_beam_size": 5,
    "english_locator": "vosk"
  },

  "browser": {
    "chrome_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "port": 9222,
    "profile_dir": "%LOCALAPPDATA%\\VoiceAssistant\\chrome-profile",
    "start_url": "https://www.google.com"
  },

  "context": {
    "ttl_sec": 180
  },

  "llm": {
    "preset": "gpt"
  },

  "llm_presets": {
    "gpt": {
      "cloud_llm": {
        "model": "openai/gpt-6-luna",
        "model_params": {
          "openai/gpt-6-luna": {
            "temperature": null,
            "reasoning_effort": "none"
          }
        }
      },
      "dialog": {
        "addressee": {
          "model": "openai/gpt-6-luna-decisions"
        }
      },
      "intent": {
        "model": "openai/gpt-6-luna-decisions"
      }
    },
    "grok": {
      "cloud_llm": {
        "model": "x-ai/grok-4.3"
      },
      "dialog": {
        "addressee": {
          "model": "openai/gpt-6-luna-decisions"
        }
      },
      "intent": {
        "model": "openai/gpt-6-luna-decisions"
      }
    }
  },

  "intent": {
    "enabled": true,
    "mode": "shadow",
    "base_url": "https://api.proxyapi.ru/v1",
    "api_key": "",
    "model": "openai/gpt-6-luna-decisions",
    "threshold": 0.6,
    "timeout_sec": 4.0,
    "answer_ttl_sec": 120
  },

  "cloud_llm": {
    "enabled": true,
    "base_url": "https://api.proxyapi.ru/v1",
    "api_key": "",
    "model": "openai/gpt-6-luna",
    "fallback_models": ["xiaomi/mimo-v2.6-flash"],
    "reasoning_effort": "minimal",
    "model_params": {
      "openai/gpt-6-luna": {
        "temperature": null,
        "reasoning_effort": "none"
      }
    },
    "max_completion_tokens": 2000,
    "temperature": 0.2,
    "timeout_sec": 90,
    "retries": 2,
    "web_search": {
      "enabled": true,
      "model": ""
    }
  },

  "vision": {
    "enabled": true,
    "model": "openai/gpt-6-luna",
    "max_width": 1280,
    "jpeg_quality": 75,
    "max_tokens": 2000,
    "timeout_sec": 60,
    "followup_ttl_sec": 60,
    "context_ttl_sec": 1800,
    "intent": {
      "enabled": true,
      "threshold": 0.6,
      "timeout_sec": 4.0
    },
    "watch": {
      "enabled": true,
      "interval_sec": 2.0,
      "auto_off_sec": 600,
      "events": {
        "enabled": true,
        "max_events": 40,
        "idle_after_sec": 120
      }
    },
    "prompt": "Опиши, что видно на экране, в двух-трёх предложениях. Если на экране текст, код или ошибка — назови главное. Если экран чёрный или пустой, так и скажи.",
    "triggers": [
      "посмотри на экран",
      "посмотри на мой экран",
      "посмотри что на экране",
      "глянь на экран",
      "что на экране",
      "что видно на экране",
      "что ты видишь на экране",
      "что у меня на экране"
    ]
  },

  "image_search": {
    "enabled": true,
    "api_key": "",
    "folder_id": "",
    "family_mode": "FAMILY_MODE_MODERATE",
    "max_results": 5,
    "max_passage_chars": 300,
    "timeout_sec": 15,
    "cooldown_sec": 3,
    "triggers": [
      "поищи по фото",
      "поищи по картинке",
      "поищи в интернете по фото",
      "найди по фото",
      "найди по картинке",
      "что это за фото",
      "что за фото",
      "поиск по фото"
    ]
  },

  "local_planner": {
    "enabled": false,
    "base_url": "http://127.0.0.1:11434/v1",
    "model": "qwen2.5:3b-instruct",
    "api_key": "",
    "timeout_sec": 20,
    "temperature": 0.0,
    "max_tokens": 256,
    "keep_alive": "30m"
  },

  "qa": {
    "enabled": true,
    "weather": {
      "city": "Новосибирск",
      "forecast_days": 3,
      "timeout_sec": 10
    },
    "search": {
      "enabled": true,
      "api_key": "",
      "max_results": 5,
      "search_depth": "basic",
      "topic": "general",
      "news_days": 7,
      "news_domains": [
        "rbc.ru", "lenta.ru", "interfax.ru", "ria.ru", "tass.ru",
        "kommersant.ru", "vedomosti.ru"
      ],
      "timeout_sec": 15
    },
    "answer": {
      "max_tokens": 400,
      "temperature": 0.2,
      "timeout_sec": 45,
      "context_ttl_sec": 180,
      "search_fallback": true
    }
  },

  "tts": {
    "enabled": false,
    "base_url": "https://api.proxyapi.ru/v1/audio/speech",
    "api_key": "",
    "model": "fish-audio/drama-3",
    "voice": "",
    "phrases_dir": "",
    "cache_dir": "",
    "speak_answers": true,
    "max_chars": 900,
    "volume": 1.0,
    "speed": 1.0,
    "workers": 3,
    "chunk_wait_sec": 30,
    "prebuffer_sec": 0,
    "timeout_sec": 60
  },

  "dialog": {
    "enabled": true,
    "auto_start": "off",
    "entry_phrases": ["давай поговорим", "давай поболтаем", "поговорим", "поболтаем"],
    "exit_phrases": ["хватит", "закончим", "закончим разговор", "заверши разговор", "до свидания"],
    "addressee": {
      "enabled": true,
      "mode": "shadow",
      "base_url": "",
      "api_key": "",
      "model": "openai/gpt-6-luna-decisions",
      "threshold": 0.6,
      "background_threshold": 0.5,
      "timeout_sec": 2.0,
      "first_turn_always_addressed": true,
      "other_names": []
    },
    "idle_timeout_sec": 60,
    "max_utterance_sec": 60,
    "no_speech_timeout_sec": 10,
    "silence_ms": 1200,
    "max_tokens": 400,
    "temperature": 0.5,
    "timeout_sec": 60,
    "max_errors": 2,
    "history_messages": 12,
    "history_chars": 4000,
    "streaming": {
      "enabled": true
    },
    "context": {
      "budget_tokens": 6000,
      "chars_per_token": 2.5,
      "rolling_summary": {
        "enabled": true,
        "min_messages": 4,
        "max_chars": 1200,
        "max_input_chars": 4000,
        "max_tokens": 250,
        "timeout_sec": 30
      }
    },
    "profile_path": "state/profile.txt",
    "profile_chars": 4000,
    "persona_path": "state/luna.txt",
    "persona_chars": 2000,
    "persona_max_facts": 100,
    "db_path": "state/dialog.db",
    "character": {
      "enabled": true
    },
    "style_observer": {
      "enabled": true,
      "window_messages": 200,
      "decision_messages": 30,
      "log_every": 10
    },
    "summary": {
      "enabled": true,
      "model": "",
      "max_input_chars": 6000,
      "max_tokens": 700,
      "temperature": 0.2,
      "timeout_sec": 45,
      "min_messages": 2,
      "background": true
    }
  },

  "memory": {
    "enabled": true,
    "model": "mongodb/voyage-4",
    "base_url": "",
    "api_key": "",
    "path": "state/chroma",
    "collection": "summaries",
    "top_k": 3,
    "min_score": 0.35,
    "min_margin": 0.05,
    "max_chars": 2400,
    "digest_min_messages": 6,
    "digest_limit": 3,
    "digest_item_chars": 320,
    "recent_limit": 2,
    "recent_item_chars": 320,
    "facts_limit": 6,
    "facts_max_chars": 900,
    "facts_collection": "facts",
    "facts_top_k": 4,
    "facts_min_score": 0.42,
    "temporary_ttl_days": 1,
    "unfinished_ttl_days": 14,
    "unfinished_limit": 5,
    "timeout_sec": 10,
    "index_version": 2
  }
}
